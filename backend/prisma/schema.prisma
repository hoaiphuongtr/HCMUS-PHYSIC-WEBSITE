generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  // Giảng viên khai hồ sơ khoa học. KHÔNG vào được trang quản trị — RolesGuard
  // chặn mặc định mọi route không ghi rõ @Roles(RoleName.Lecturer).
  LECTURER
}

/// Quan hệ công tác với Khoa. Quyết định người đó có được tính vào thống kê và
/// định mức nhiệm vụ của Khoa hay không — thỉnh giảng thì không.
enum AffiliationType {
  /// Cơ hữu — thuộc biên chế/hợp đồng của Khoa.
  FULL_TIME
  /// Kiêm nhiệm — công tác chính ở đơn vị khác trong Trường.
  JOINT
  /// Thỉnh giảng — mời dạy, không thuộc Khoa.
  VISITING
}

/// Bậc đào tạo sau đại học mà giảng viên ĐANG theo học.
/// Nhiều giảng viên vừa dạy vừa làm nghiên cứu sinh — thông tin này cần cho
/// trang nhân sự và cho việc xét định mức nhiệm vụ.
enum GradStudyLevel {
  MASTER
  PHD
  POSTDOC
}

/// Tình trạng bài báo. Mặc định PUBLISHED: phần lớn bài được khai sau khi đã in.
enum PublicationStatus {
  SUBMITTED
  ACCEPTED
  IN_PRESS
  PUBLISHED
  RETRACTED
}

/// Một bài được dùng chung cho mọi đồng tác giả trong Khoa. Người khai đầu tiên
/// gắn tên đồng nghiệp vào; những người đó phải tự xác nhận thì mới được tính.
enum AuthorClaimStatus {
  CONFIRMED
  PENDING
  REJECTED
}

enum Language {
  EN
  VI
}

enum ContentStatus {
  DRAFT
  PENDING
  SCHEDULED
  PUBLISHED
}

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
  TEMPLATE_SNAPSHOT
}

// PostCategory enum dropped in favor of relation to Category model
// (see Category model below). Kept as type ref via enum until migration
// completes is not needed — Prisma will infer through Post.category relation.

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum TranslationProvider {
  LARA
  DEEPSEEK
  GROK
  MANUAL
}

enum BlockType {
  PARAGRAPH
  HEADING
  IMAGE
  VIDEO
  LINK
  REGISTRATION_FORM
  QUOTE
  LIST
  DIVIDER
  EMBED
}

enum VerificationCodeType {
  FORGOT_PASSWORD
}

enum ReactionType {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
}

enum WidgetCategory {
  FEED_COMPONENTS
  UTILITY_INFO
  CONTENT
  NAVIGATION
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  firstName         String?
  lastName          String?
  password          String?
  avatarUrl         String?
  googleId          String?   @unique
  role              Role      @default(ADMIN)
  isActive          Boolean   @default(true)
  hasSetPreferences Boolean   @default(false)
  phone             String?
  position          String?
  bio               String?
  departmentId      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?
  tourCompletedAt   DateTime?

  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  preference         UserPreference?
  sessions           Session[]
  accounts           Account[]
  templates          Template[]
  posts              Post[]
  postsApproved      Post[]              @relation("PostApprovedBy")
  postReactions      PostReaction[]
  postComments       PostComment[]
  postTranslations   PostTranslation[]
  media              Media[]
  notifications      Notification[]
  faqItems           FAQ[]
  faqUpdated         FAQ[]               @relation("FAQUpdatedBy")
  chatbotTraining    ChatbotTraining[]
  auditLogs          AuditLog[]
  pageLayouts        PageLayout[]
  pageLayoutVersions PageLayoutVersion[]
  scholarProfile     ScholarProfile?
  publicationAuthors PublicationAuthor[]

  @@index([role])
  @@index([email])
  @@index([googleId])
  @@index([departmentId])
}

model UserPreference {
  id                   String                @id @default(cuid())
  userId               String                @unique
  categories           String[]
  tags                 String[]
  starredLayoutIds     String[]              @default([])
  starredWidgetIds     String[]              @default([])
  notificationChannels NotificationChannel[] @default([EMAIL, IN_APP])
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model VerificationCode {
  id        String               @id @default(cuid())
  email     String
  code      String
  type      VerificationCodeType
  expiresAt DateTime
  createdAt DateTime             @default(now())

  @@unique([email, type])
  @@index([expiresAt, email])
}

model Department {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  // Phân loại đơn vị: "department" = bộ môn (hiện như bộ môn), "unit" = đơn vị
  // khác (Đoàn – Hội, CLB…) — KHÔNG coi là bộ môn ở các listing động.
  kind              String   @default("department")
  // Danh muc MAC DINH cua don vi: bai do tai khoan thuoc don vi nay dang se LUON
  // duoc gan danh muc do (vd CLB -> "Cau lac bo"), khong phu thuoc nguoi dang co
  // nho tick hay khong. De trong = khong ep gi.
  defaultCategoryId String?
  description       String?
  email             String?
  phone             String?
  address           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users       User[]
  posts       Post[]       @relation("PostDepartment")
  media       Media[]      @relation("MediaDepartment")
  pageLayouts PageLayout[] @relation("PageLayoutDepartment")

  @@index([slug])
}

model Template {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  structure   Json
  isActive    Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  snapshotId  String?  @unique

  createdByUser User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  snapshot      Media? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  posts         Post[]

  @@index([createdBy])
  @@index([isActive])
}

model Post {
  id              String        @id @default(cuid())
  title           Json
  slug            String        @unique
  body            Json?
  excerpt         Json?
  departmentId    String?
  legacyId        Int?          @unique
  status          ContentStatus @default(DRAFT)
  coverMediaId    String?
  coverUrl        String?
  coverAlt        String?
  publishedAt     DateTime?
  scheduledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       String
  approvedBy      String?
  templateId      String?
  eventStartAt    DateTime?
  eventEndAt      DateTime?
  eventLocation   String?
  eventSpeakers   Json?
  registrationUrl String?
  metadata        Json?
  aiSummary       String?
  deletedAt       DateTime?

  createdByUser  User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  approvedByUser User?             @relation("PostApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  template       Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  coverMedia     Media?            @relation("PostCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  department     Department?       @relation("PostDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  contentBlocks  ContentBlock[]
  translations   PostTranslation[]
  reactions      PostReaction[]
  comments       PostComment[]
  postTags       PostTag[]
  media          PostMedia[]
  seoMetadata    SEOMetadata?
  layouts        PageLayout[]      @relation("PageLayoutSourcePost")

  @@index([status])
  @@index([departmentId])
  @@index([createdBy])
  @@index([publishedAt])
  @@index([scheduledAt])
  @@index([slug])
  @@index([eventStartAt])
  @@index([coverMediaId])
  @@index([deletedAt])
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      Json
  excerpt   Json?
  image     String?
  legacyId  Int?     @unique
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  layouts     PageLayout[]             @relation("PageLayoutCategory")
  layoutLinks PageLayoutCategoryLink[]

  @@index([slug])
}

model ContentBlock {
  id        String    @id @default(cuid())
  postId    String
  type      BlockType
  content   Json
  order     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([order])
}

model PostTranslation {
  id          String              @id @default(cuid())
  postId      String
  language    Language
  title       String
  excerpt     String?
  blocks      Json
  aiSummary   String?
  provider    TranslationProvider
  isConfirmed Boolean             @default(false)
  confirmedBy String?
  confirmedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  post          Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  confirmedUser User? @relation(fields: [confirmedBy], references: [id], onDelete: SetNull)

  @@unique([postId, language])
  @@index([postId])
  @@index([language])
}

model PostReaction {
  id        String       @id @default(cuid())
  postId    String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  parentId  String?
  content   String
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies PostComment[] @relation("CommentReplies")

  @@index([postId])
  @@index([userId])
  @@index([parentId])
}

model Widget {
  id            String         @id @default(cuid())
  type          String         @unique
  name          String
  description   String?
  usage         String?
  category      WidgetCategory
  icon          String?
  configSchema  Json
  defaultConfig Json           @default("{}")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  instances WidgetInstance[]

  @@index([category])
  @@index([isActive])
}

model WidgetInstance {
  id           String   @id @default(cuid())
  widgetId     String
  pageLayoutId String
  config       Json     @default("{}")
  order        Int
  row          Int      @default(0)
  colSpan      Int      @default(12)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  widget     Widget     @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  pageLayout PageLayout @relation(fields: [pageLayoutId], references: [id], onDelete: Cascade)

  @@index([pageLayoutId])
  @@index([widgetId])
  @@index([order])
}

model PageLayout {
  id                String    @id @default(cuid())
  name              String
  slug              String
  description       String?
  puckData          Json?
  publishedPuckData Json?
  isPublished       Boolean   @default(false)
  publishedAt       DateTime?
  scheduledAt       DateTime?
  sourcePostId      String?
  departmentId      String?
  categoryId        String?
  // Đánh dấu TƯỜNG MINH đây là layout mẫu để tạo bài mới. Trước đây hệ thống
  // suy đoán "có categoryId + không sinh từ bài" nên mọi trang giới thiệu/liên
  // hệ lỡ gắn danh mục đều lọt vào danh sách mẫu.
  isPostTemplate    Boolean   @default(false)
  // Layout RIÊNG: chỉ người tạo (và super admin) thấy/dùng được. Mặc định false
  // = dùng chung trong phạm vi bộ môn như trước.
  isPrivate         Boolean   @default(false)
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  createdByUser User                     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  sourcePost    Post?                    @relation("PageLayoutSourcePost", fields: [sourcePostId], references: [id], onDelete: SetNull)
  department    Department?              @relation("PageLayoutDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  category      Category?                @relation("PageLayoutCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  // Một trang tin có thể nằm dưới NHIỀU danh mục (vd vừa Câu lạc bộ vừa Tin
  // học vụ) mà vẫn chỉ có MỘT URL. categoryId ở trên là danh mục CHÍNH, dùng
  // cho breadcrumb; bảng nối này mới là nguồn cho bộ lọc danh mục.
  categoryLinks PageLayoutCategoryLink[]
  widgets       WidgetInstance[]
  seoMetadata   SEOMetadata?
  versions      PageLayoutVersion[]

  @@index([slug])
  @@index([isPublished])
  @@index([departmentId])
  @@index([categoryId])
  @@index([createdBy])
  @@index([scheduledAt])
  @@index([sourcePostId])
  @@index([deletedAt])
  @@index([isPostTemplate])
}

model PageLayoutCategoryLink {
  pageLayoutId String
  categoryId   String

  pageLayout PageLayout @relation(fields: [pageLayoutId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([pageLayoutId, categoryId])
  @@index([categoryId])
}

enum PageLayoutVersionStatus {
  CURRENT
  ARCHIVED
}

model PageLayoutVersion {
  id            String                  @id @default(cuid())
  pageLayoutId  String
  versionNumber Int
  name          String
  slug          String
  description   String?
  puckData      Json?
  status        PageLayoutVersionStatus @default(ARCHIVED)
  publishedAt   DateTime
  publishedBy   String
  createdAt     DateTime                @default(now())

  pageLayout      PageLayout @relation(fields: [pageLayoutId], references: [id], onDelete: Cascade)
  publishedByUser User       @relation(fields: [publishedBy], references: [id], onDelete: Cascade)

  @@unique([pageLayoutId, versionNumber])
  @@index([pageLayoutId])
  @@index([status])
  @@index([publishedAt])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postTags  PostTag[]
  mediaTags MediaTag[]

  @@index([slug])
}

model PostTag {
  postId    String
  tagId     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model MediaTag {
  mediaId   String
  tagId     String
  createdAt DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
  @@index([tagId])
}

model Media {
  id           String    @id @default(cuid())
  name         String
  type         MediaType
  url          String
  mimeType     String?
  size         Int?
  width        Int?
  height       Int?
  alt          String?
  createdBy    String
  departmentId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdByUser    User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  department       Department? @relation("MediaDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  templateSnapshot Template?
  postMedia        PostMedia[]
  mediaTags        MediaTag[]
  postCovers       Post[]      @relation("PostCoverMedia")

  @@index([createdBy])
  @@index([departmentId])
  @@index([type])
}

model PostMedia {
  id        String   @id @default(cuid())
  postId    String
  mediaId   String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaId])
  @@index([mediaId])
}

model SEOMetadata {
  id              String   @id @default(cuid())
  postId          String?  @unique
  pageLayoutId    String?  @unique
  metaTitle       String?
  metaDescription String?
  keywords        String?
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  post       Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  pageLayout PageLayout? @relation(fields: [pageLayoutId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  channel   NotificationChannel
  isRead    Boolean             @default(false)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Subscription {
  id         String    @id @default(cuid())
  email      String    @unique
  visitorId  String?
  tagSlugs   String[]
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([visitorId])
}

model VisitorProfile {
  id          String   @id @default(cuid())
  tagWeights  Json     @default("{}")
  slugWeights Json     @default("{}")
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SlugVisit {
  id        String   @id @default(cuid())
  visitorId String
  slug      String
  createdAt DateTime @default(now())

  @@index([visitorId, slug])
  @@index([slug, createdAt])
}

model PostRead {
  id        String   @id @default(cuid())
  visitorId String
  postId    String
  createdAt DateTime @default(now())

  @@index([visitorId, postId])
  @@index([postId, createdAt])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdBy String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByUser User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  updatedByUser User?             @relation("FAQUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  trainingData  ChatbotTraining[]

  @@index([isActive])
  @@index([category])
  @@index([createdBy])
}

model ChatbotTraining {
  id        String   @id @default(cuid())
  faqId     String?
  question  String
  answer    String
  context   String?
  language  Language
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByUser User @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  faq           FAQ? @relation(fields: [faqId], references: [id], onDelete: SetNull)

  @@index([language])
  @@index([isActive])
  @@index([createdBy])
  @@index([faqId])
}

// Standalone HTML pages served on the public domain WITHOUT the Puck layout
// designer — e.g. one-off event microsites (/iceba2023). Completely separate from
// PageLayout: the public catch-all falls back to this only when no layout matches,
// so the existing layout flow is untouched. Raw table created via a manual
// migration (see prisma/migrations/20260730_static_page) to avoid `prisma db push`
// dropping the raw ChatbotChunk table on the restored DB.
model StaticPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  html        String
  // 'iframe' = render the full HTML document isolated in an iframe (default, safe
  // for full microsites); 'embed' = inject as a fragment inside the site shell.
  renderMode  String   @default("iframe")
  // When a folder microsite is uploaded as a .zip it is extracted under the
  // persistent uploads volume; bundlePath is the served entry (e.g.
  // /uploads/static-sites/<id>/index.html) and takes precedence over html.
  bundlePath  String?
  isPublished Boolean  @default(false)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@index([action])
}

model AIConfig {
  id        String   @id @default(cuid())
  provider  String
  model     String
  purpose   String
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  rateLimit Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, model, purpose])
  @@index([purpose])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Hồ sơ khoa học — xem docs/ho-so-khoa-hoc.md
//
// Web Khoa là chủ sở hữu duy nhất của dữ liệu công bố. App
// profile.phys.hcmus.edu.vn và ACADsoom đều chỉ là khách của API, không giữ bản
// sao. Vì vậy mọi ràng buộc dữ liệu phải nằm ở đây, không nằm ở tầng giao diện.
// ─────────────────────────────────────────────────────────────────────────────

/// Lý lịch khoa học của một tài khoản: định danh ngoài + nối sang trang nhân sự.
model ScholarProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  orcid           String?   @unique
  scopusAuthorId  String?
  researcherId    String?
  googleScholarId String?
  /// ResearchGate không có API công khai — chỉ lưu để hiển thị, không đồng bộ.
  researchGateUrl String?
  /// Slug trang nhân sự trên web Khoa. Web Khoa chưa có thực thể "nhân sự"
  /// riêng; trang nhân sự vẫn là PageLayout, nên đây là chỗ nối tạm.
  staffPageSlug   String?
  showOnWeb       Boolean   @default(true)
  lastOrcidSyncAt DateTime?

  // ── Quan hệ công tác ──────────────────────────────────────────────────────
  /// Để trống = CHƯA KHAI. Cố ý không đặt mặc định FULL_TIME: đoán bừa rồi tính
  /// nhầm một người thỉnh giảng vào định mức của Khoa còn tệ hơn là để trống.
  affiliationType AffiliationType?
  /// Đơn vị công tác chính — chỉ có ý nghĩa với kiêm nhiệm và thỉnh giảng.
  homeInstitution String?

  // ── Đang học sau đại học ──────────────────────────────────────────────────
  /// Để trống = không đang theo học chương trình nào.
  gradStudyLevel       GradStudyLevel?
  gradStudyField       String?
  gradStudyInstitution String?
  gradStudyCountry     String?
  gradStudyStartYear   Int?
  /// Năm DỰ KIẾN hoàn thành — không phải năm đã xong.
  gradStudyEndYear     Int?
  /// Được cử đi học toàn thời gian. Là dữ kiện ảnh hưởng tới định mức nhiệm vụ,
  /// nên tách riêng thay vì nhét vào ghi chú.
  gradStudyFullTime    Boolean @default(false)
  gradStudyNote        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  nameVariants ScholarNameVariant[]

  @@index([staffPageSlug])
}

/// Các dạng tên một người dùng khi đăng báo ("Nguyen V. T. N.", "N. V. T. Ngan").
/// Đây là bộ khớp tên: khi ai đó khai một bài, hệ thống dò danh sách tác giả của
/// bài theo bảng này để đoán ai trong Khoa có mặt trong đó.
model ScholarNameVariant {
  id         String   @id @default(cuid())
  profileId  String
  /// Nguyên văn người dùng nhập, để hiển thị lại.
  raw        String
  /// Dạng đã chuẩn hoá để so khớp — xem normalizeName() trong name-match.ts.
  normalized String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  profile ScholarProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, normalized])
  @@index([normalized])
}

/// Một công trình = một dòng, dùng chung cho mọi đồng tác giả trong Khoa.
/// Gom theo DOI: bài ba người trong Khoa cùng đứng tên vẫn chỉ là MỘT dòng, nếu
/// không thì trang nhân sự hiện ba bản và thống kê Khoa đếm ba lần.
model Publication {
  id             String  @id @default(cuid())
  doi            String? @unique
  arxivId        String?
  isbn           String?
  issn           String?
  type           String  @default("journal-article")
  title          String
  containerTitle String?
  volume         String?
  issue          String?
  pages          String?
  publisher      String?
  url            String?

  status         PublicationStatus @default(PUBLISHED)
  publishedYear  Int?
  publishedMonth Int?
  acceptedYear   Int?
  acceptedMonth  Int?
  /// Năm dùng để tính KPI = publishedYear, hoặc acceptedYear nếu chưa in.
  /// Suy ra lúc ghi (xem resolveCountYear) để lọc theo năm là truy vấn có index.
  countYear      Int?

  /// Danh sách tác giả theo ĐÚNG thứ tự gốc: [{ family, given, sequence, orcid }].
  authorsRaw Json
  source     String @default("manual")
  raw        Json?

  /// Mã Phụ lục 2 do TÁC GIẢ TỰ CHỌN. null = chưa phân loại → không lọt vào API
  /// tích hợp → không được tính KPI. Hệ thống không tự đoán quartile.
  catalogCode  String?
  quartile     String?
  classifiedBy String?
  classifiedAt DateTime?

  /// Hệ số tính chất bài — thuộc về BÀI, không thuộc về từng người.
  satellite   Boolean @default(false)
  reprint     Boolean @default(false)
  fromProject Boolean @default(false)
  stage       Int     @default(0)

  totalAuthors       Int     @default(1)
  schoolAuthors      Int     @default(1)
  mainAuthorAtSchool Boolean @default(false)

  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  authors PublicationAuthor[]

  @@index([countYear])
  @@index([catalogCode])
  @@index([status])
  @@index([deletedAt])
  @@index([issn])
}

/// Một giảng viên trong Khoa đứng tên trong một công trình.
/// claimStatus là cơ chế xác nhận: người tự khai được CONFIRMED ngay, người bị
/// đồng nghiệp gắn tên vào ở PENDING cho tới khi chính họ xác nhận.
model PublicationAuthor {
  id              String            @id @default(cuid())
  publicationId   String
  userId          String
  /// Vị trí trong authorsRaw; -1 = chưa chỉ được là tác giả nào.
  authorIndex     Int               @default(-1)
  isFirst         Boolean           @default(false)
  isCorresponding Boolean           @default(false)
  isLast          Boolean           @default(false)
  /// Cách 1 của Phụ lục 2 — nhóm tự thoả thuận tỷ lệ chia giờ.
  sharePercent    Int?
  claimStatus     AuthorClaimStatus @default(PENDING)
  invitedBy       String?
  respondedAt     DateTime?
  showOnWeb       Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([publicationId, userId])
  @@index([userId, claimStatus])
}
