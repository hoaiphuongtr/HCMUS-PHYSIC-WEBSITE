phys.hcmus.edu.vn {
	encode gzip zstd
	# API backend dưới tiền tố /be (KHÔNG dùng /api vì trang public có route /api/og, /api/revalidate riêng)
	handle_path /be/* {
		reverse_proxy backend:3001
	}
	# Ảnh/tệp tải lên (kể cả link /uploads thô trong nội dung legacy)
	handle /uploads/* {
		reverse_proxy backend:3001
	}
	# Còn lại → trang công khai (Next.js)
	handle {
		reverse_proxy public:3002
	}
}

# Trang quản trị qua HTTPS trên cổng 3000 (app tự chuyển / → /admin). Container
# admin KHÔNG map cổng 3000 trên host nữa — Caddy giữ cổng đó và proxy nội bộ.
phys.hcmus.edu.vn:3000 {
	reverse_proxy admin:3000
}

# Dự phòng: cổng 8443 cũng vào admin (phòng khi cần).
phys.hcmus.edu.vn:8443 {
	reverse_proxy admin:3000
}
