phys.hcmus.edu.vn {
	encode gzip zstd
	# API backend dưới tiền tố /be (KHÔNG dùng /api vì trang public có route /api/og, /api/revalidate riêng)
	handle_path /be/* {
		reverse_proxy backend:3001
	}
	# Ảnh/tệp tải lên (kể cả link /uploads thô trong nội dung legacy)
	handle /uploads/* {
		reverse_proxy backend:3001
	}
	# Còn lại → trang công khai (Next.js)
	handle {
		reverse_proxy public:3002
	}
}

# Trang quản trị qua HTTPS trên cổng 8443 (dùng chung chứng chỉ phys.hcmus.edu.vn).
# Cần vì trình duyệt tự nâng http→https nên admin cổng 3000 (không TLS) bị lỗi
# ERR_SSL_PROTOCOL_ERROR. Truy cập: https://phys.hcmus.edu.vn:8443/admin
phys.hcmus.edu.vn:8443 {
	reverse_proxy admin:3000
}
